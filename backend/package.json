{
  "name": "person-crud-backend",
  "version": "1.0.0",
  "description": "Person CRUD API - Node.js + PostgreSQL + Redis + RabbitMQ",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "node-pg-migrate": "^7.5.2"
  },
  "node-pg-migrate": {
    "dir": "migrations",
    "databaseUrlEnv": "DATABASE_URL"
  }
}
